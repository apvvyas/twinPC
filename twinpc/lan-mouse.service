[Unit]
Description=lan-mouse — share mouse and keyboard between this PC and the main PC
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# layer-shell capture: the input-capture portal path crashes Hyprland 0.56 (libeis assertion)
ExecStart=/usr/bin/lan-mouse --capture-backend layer-shell daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
